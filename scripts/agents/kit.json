{
  "project": "producer",
  "branches": {
    "land": "dev",
    "release": "main"
  },
  "commands": "scripts/agents/project.d",
  "maps": "docs/wayfinder",
  "rulebookExtras": "docs/agents/kitchen-extras.md",
  "checks": {
    "test": "scripts/agents/kit unit"
  },
  "unit": {
    "run": "node --test",
    "files": "test/*.test.mjs"
  },
  "standards": [
    "AGENTS.md"
  ],
  "paths": {
    "visible": [
      "^src/page\\.html$",
      "^src/(app|theme)\\.css$",
      "^src/app\\.js$",
      "^src/listen\\.mjs$",
      "^src/ui/",
      "^scripts/build\\.mjs$"
    ]
  }
}
